{% extends "../../layouts/default-gds.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  {{ texts.RESPONSE_INFO.CHANGE_DATES.HEADING }} - {{ texts.INTERFACE.SERVICE_TITLE }} - {{ texts.INTERFACE.GOV }}
{% endblock %}

{% block page_identifier %}{{ texts.RESPONSE_INFO.CHANGE_DATES.PAGE_IDENTIFIER }}{% endblock %}

{% block containerStart %}
  {{ super() }}
  {% include "../../includes/back-link-gds.njk" %}
{% endblock %}

{% block content %}

  {% set welsh = texts.INTERFACE.HTML_LANG == "cy" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      
      <h1 class="govuk-heading-l govuk-!-margin-bottom-6">{{ texts.RESPONSE_INFO.CHANGE_DATES.HEADING }}</h1>

      <p class="govuk-body">{{ texts.RESPONSE_INFO.CHANGE_DATES.INTRO }}</p>

      {% if not welsh %}
        <h2 class="govuk-heading-m">{{ texts.RESPONSE_INFO.CHANGE_DATES.CHANGING_YOUR_DATES.TITLE }}</h2>
      {% endif %}
      <p class="govuk-body">{{ texts.RESPONSE_INFO.CHANGE_DATES.CHANGING_YOUR_DATES.CONTENT_1 }}</p>

      {% if not welsh %}
        <h2 class="govuk-heading-m">{{ texts.RESPONSE_INFO.CHANGE_DATES.BEING_EXCUSED.TITLE }}</h2>
      {% endif %}
      <p class="govuk-body">{{ texts.RESPONSE_INFO.CHANGE_DATES.BEING_EXCUSED.CONTENT_1 }}</p>
      <p class="govuk-body">{{ texts.RESPONSE_INFO.CHANGE_DATES.BEING_EXCUSED.CONTENT_2 }}</p>
      {% set content_3_link %}
        <a class="govuk-link" href="{{ texts.RESPONSE_INFO.CHANGE_DATES.BEING_EXCUSED.CONTENT_3_LINK }}" target="_blank">
          {{ texts.RESPONSE_INFO.CHANGE_DATES.BEING_EXCUSED.CONTENT_3_LINK }}
        </a>
      {% endset %}
      <p class="govuk-body">{{ texts.RESPONSE_INFO.CHANGE_DATES.BEING_EXCUSED.CONTENT_3 | replace("[link]", content_3_link) | safe }}</p>
      
      {{ govukButton({
        text: texts.RESPONSE_INFO.COMMON.START_RESPONSE,
        href: responseStartUrl
      }) }}

    </div>
  </div>

{% endblock %}
