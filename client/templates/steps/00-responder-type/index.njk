{% extends "../../layouts/default-gds.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  {% include "../../includes/title-error.njk" %}
  {{ texts.REPLY_TYPE.HEADER }} - {{ texts.INTERFACE.SERVICE_TITLE }} - {{ texts.INTERFACE.GOV }}
{% endblock %}

{% block page_identifier %}Responder Type{% endblock %}

{% block content %}
  
  {% include "../../includes/errors-gds.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form action="{{ url('steps.responder.type.post') }}" method="post">

        {% if errors.count > 0 %}
          {% set radiosError = {text: errors.items['thirdParty'][0].details, visuallyHiddenText: texts.ERRORS.HIDDEN_ERROR} %}
        {% else %}
          {% set radiosError = undefined %}
        {% endif %}
        
        {{ govukRadios({
          classes: "govuk-radios",
          name: "thirdParty",
          fieldset: {
            legend: {
              text: texts.REPLY_TYPE.HEADER,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          errorMessage: radiosError,
          items: [
            {
              id: "thirdParty_No",
              value: "No",
              text: texts.REPLY_TYPE.REPLY_SELF,
              hint: {
                text: texts.REPLY_TYPE.REPLY_SELF_INFO
              }
            },
            {
              id: "thirdParty_Yes",
              value: "Yes",
              text: texts.REPLY_TYPE.REPLY_TP,
              hint: { 
                text: texts.REPLY_TYPE.REPLY_TP_INFO
              }
            }
          ]})
        }}

        {% set guidanceText %}
          <p>
            {{ texts.REPLY_TYPE.NEED_HELP.INFO }}
          </p>
          {% set we_are_group_tel_no %}
            <a href="{{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.TELEPHONE_LINK }}">{{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.TEL_NO }}</a>
          {% endset %}
          {% set we_are_group_email %}
            <a href="{{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.EMAIL_LINK }}">{{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.EMAIL_ADDRESS }}</a>
          {% endset %}
          {% set we_are_group_text_no %}
            <a href="{{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.TEXT_LINK }}">{{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.TEXT_NO }}</a>
          {% endset %}
          <p>
            {{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.SERVICE }} <br>
            {{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.TELEPHONE | replace('[tel_no]', we_are_group_tel_no) | safe }} <br>
            {{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.OPENING }} <br>
            {{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.TEXT | replace('[text_no]', we_are_group_text_no) | safe }} <br>
            {{ texts.REPLY_TYPE.NEED_HELP.CONTACT_DETAILS.EMAIL | replace('[email]', we_are_group_email) | safe }}
          </p>
          {% set bureau_tel_no %}
            <a href="{{ texts.REPLY_TYPE.NEED_HELP.BUREAU_HELP_TEL_LINK }}">{{ texts.REPLY_TYPE.NEED_HELP.BUREAU_HELP_TEL_NO }}</a>
          {% endset %}
          <p>
            {{ texts.REPLY_TYPE.NEED_HELP.BUREAU_HELP | replace('[tel_no]', bureau_tel_no) | safe }}
          </p>
          <p>
            <a href="{{ texts.REPLY_TYPE.NEED_HELP.CALL_CHARGES_LINK }}">{{ texts.REPLY_TYPE.NEED_HELP.CALL_CHARGES }}</a>
          </p>
        {% endset %}
  
        <details class="govuk-details" data-module="govuk-details">
          <summary class="govuk-details__summary ga-details-help-replying">
            <span class="govuk-details__summary-text ga-details-help-replying">
              {{ texts.REPLY_TYPE.NEED_HELP.TITLE }}
            </span>
          </summary>
          <div class="govuk-details__text">
            {{ guidanceText | safe }}
          </div>
        </details>

        {# Submit form #}
        {{ govukButton({
          text: texts.INTERFACE.BUTTON_TEXT_CONTINUE
        }) }}

        <input type="hidden" name="_csrf" value="{{ csrftoken }}">

      </form>
    </div>
  </div>

{% endblock %}
