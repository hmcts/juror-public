{% extends "../../layouts/default-gds.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block pageTitle %}
  Your jury summons information is online - Reply to a jury summons - GOV.UK
{% endblock %}

{% block page_identifier %}Digital Summons{% endblock %}

{% block content %}
  {% set pageHeading = "Your jury summons information is online" %}
  {% set notAvailable = "Not available" %}

  {% set summonsDate = "" %}
  {% if digitalSummons and digitalSummons.summonsDate %}
    {% set summonsDate = digitalSummons.summonsDate %}
  {% endif %}

  {% set courtName = notAvailable %}
  {% if digitalSummons and digitalSummons.courtName %}
    {% set courtName = digitalSummons.courtName %}
  {% endif %}

  {% set guidanceCards = [
    {
      id: "what",
      title: "What jury service involves",
      description: "What happens before you attend, how jurors are selected, and what to expect."
    },
    {
      id: "attend",
      title: "When and where to attend",
      description: "Your date, court address, arrival time, security, travel, and parking."
    },
    {
      id: "expenses",
      title: "Claiming expenses",
      description: "Travel, food, loss of earnings, childcare, and other financial support."
    },
    {
      id: "work",
      title: "Employment and time off work",
      description: "Information for employees, employers, self-employed jurors, and students."
    },
    {
      id: "date",
      title: "Ask to change your dates",
      description: "When you may be able to defer jury service and what evidence you might need."
    },
    {
      id: "support",
      title: "Support and accessibility",
      description: "Request reasonable adjustments, language support, or help with health needs."
    },
    {
      id: "eligibility",
      title: "Juror eligibility",
      description: "Read the eligibility questions you will be asked as part of your reply."
    }
  ] %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">
        {{ pageHeading }}
      </h1>

      <p class="govuk-body-l">
        You are signed in. You can read the information that would normally be included in a printed summons pack, then start your response.
      </p>

      {% call govukInsetText() %}
        <p class="govuk-body">
          <strong>Summons date:</strong>
          {% if summonsDate %}
            {{ summonsDate | translateDate("YYYY-MM-DD", "dddd D MMMM YYYY", "en") }}
          {% else %}
            {{ notAvailable }}
          {% endif %}
        </p>
        <p class="govuk-body">
          <strong>Court:</strong> {{ courtName }}
        </p>
      {% endcall %}

      {{ govukButton({
        text: "Start your response",
        href: startResponseUrl
      }) }}

      <h2 class="govuk-heading-l">
        Jury service information
      </h2>

      <div class="govuk-grid-row digital-summons-cards">
        {% for card in guidanceCards %}
          <div class="govuk-grid-column-one-half govuk-!-margin-bottom-4">
            <a class="digital-summons-card" href="?guidance={{ card.id }}">
              <h3 class="govuk-heading-s digital-summons-card__title">
                {{ card.title }}
              </h3>
              <p class="govuk-body digital-summons-card__description">
                {{ card.description }}
              </p>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endblock %}
